---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/site';
const official = [
  { name: 'Visual Studio Code', domain: 'code.visualstudio.com', href: 'https://code.visualstudio.com/download' },
  { name: 'MSYS2 · proposed Windows compiler path', domain: 'msys2.org', href: 'https://www.msys2.org/' },
  { name: 'Python for Windows', domain: 'python.org', href: 'https://www.python.org/downloads/windows/' },
  { name: 'Git for Windows', domain: 'git-scm.com', href: 'https://git-scm.com/install/windows' },
  { name: 'GitHub', domain: 'github.com', href: 'https://github.com/' },
];
---
<Base title="Downloads" active="downloads">
  <header class="page-heading"><h1>Keep a copy.<br />Keep going.</h1><p>Download the setup guide and verification programs.</p></header>
  <div class="downloads-list">
    <section class="download-row"><div><h2>The complete setup guide</h2><p>Seven guides with source links and a readiness checklist.</p><small>Markdown (.md)</small></div><a class="button" href={url('downloads/starter-guide.md')} download><Icon name="download" size={16} />Download guide</a></section>
    <section class="download-row"><div><h2>A copy for printing</h2><p>Print all guides or save them as a PDF.</p></div><a class="button secondary" href={url('print/')}><Icon name="print" size={16} />Open print view</a></section>
    <section class="download-row"><div><h2>Verification programs</h2><p>Three source files and a short README. Extract the ZIP into your practice folder, then follow the verification guide to compile and run them.</p><small>ZIP · source only · hello.c, hello.cpp, hello.py, README.txt</small></div><a class="button" href={url('downloads/verification-programs.zip')} download><Icon name="download" size={16} />Download programs</a></section>
    <section class="download-row"><div><h2>Just one source file?</h2><p><a href={url('downloads/hello.c')} download>hello.c</a> · <a href={url('downloads/hello.cpp')} download>hello.cpp</a> · <a href={url('downloads/hello.py')} download>hello.py</a> · <a href={url('downloads/README.txt')} download>Instructions</a></p><small>Save the exact filename. These are plain-text source files, not installers.</small></div><a class="text-link" href={url('guides/verify/')}>See the commands <Icon name="arrow" size={15} /></a></section>
  </div>
  <section class="official-links" aria-labelledby="official-title"><h2 id="official-title">Get your tools from the source.</h2><p class="muted" style="font-size: 12px; margin-top: 10px">Use official downloads. Confirm your device architecture and read the relevant setup guide before choosing an installer.</p>{official.map(tool => <a class="official-link-row" href={tool.href}><span>{tool.name}<br /><small>{tool.domain}</small></span><Icon name="external" size={16} /></a>)}</section>
  <div class="inline-notice">Proposed environment: MSYS2 UCRT64 and Python 3.14. Faculty confirmation is pending.</div>
</Base>
