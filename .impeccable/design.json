    {
      "name": "Progress Note",
      "kind": "card",
      "refersTo": "progress-note",
      "description": "Optional on-device setup reminder with a native progress meter.",
      "html": "<section class=\"ds-progress-note\"><h3>A little progress, every step.</h3><p class=\"ds-progress-count\">2 of 6 guides marked complete</p><progress class=\"ds-progress\" max=\"6\" value=\"2\" aria-label=\"Guides marked complete\"></progress><p class=\"ds-progress-copy\">Saved only in this browser. Your checkmarks are a personal reminder, not a setup test.</p><button class=\"ds-reset\" type=\"button\">Reset my progress</button></section>",
      "css": ".ds-progress-note{background:var(--soft-blue,#edf5ff);color:var(--ink,#152b48);padding:21px;border-radius:12px;max-width:220px;font-family:var(--body,Manrope,sans-serif)}.ds-progress-note h3{font-size:13px;font-weight:800;line-height:1.35;margin:0}.ds-progress-count{margin:16px 0 7px;font-size:10px;color:var(--note-ink,#365879);line-height:1.7}.ds-progress{display:block;width:100%;height:5px;border:none;background:#d1e1f4;accent-color:var(--blue,#004aad);border-radius:5px;overflow:hidden}.ds-progress::-webkit-progress-bar{background:#d1e1f4}.ds-progress::-webkit-progress-value{background:var(--blue,#004aad);transition:width .3s ease-out}.ds-progress-copy{color:var(--note-ink,#365879);font-size:11px;line-height:1.8;margin:13px 0 0}.ds-reset{background:none;border:0;padding:0;color:var(--note-ink,#365879);font-family:var(--body,Manrope,sans-serif);font-size:9px;text-decoration:underline;text-underline-offset:3px;margin-top:12px;cursor:pointer}.ds-reset:focus-visible{outline:3px solid var(--sky,#38b6ff);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-progress::-webkit-progress-value{transition:none}}"
    },
    {
      "name": "Setup Path Row",
      "kind": "custom",
      "refersTo": "path-row",
      "description": "Ruled guide link in the ordered setup sequence.",
      "html": "<a class=\"ds-path-row\" href=\"#readiness\"><span class=\"ds-path-index\">01</span><span><span class=\"ds-path-title\">Before you begin</span><span class=\"ds-path-description\">Check your device and prepare a place to practice.</span></span><span class=\"ds-path-time\">10 min</span><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"></path></svg></a>",
      "css": ".ds-path-row{display:grid;grid-template-columns:35px 1fr auto 16px;gap:15px;align-items:center;padding:20px 0;border-block:1px solid var(--line,#dce4ee);text-decoration:none;color:var(--ink,#152b48);font-family:var(--body,Manrope,sans-serif);line-height:1.7}.ds-path-row:hover .ds-path-title{color:var(--blue,#004aad)}.ds-path-index{display:flex;width:33px;height:33px;justify-content:center;align-items:center;border:1px solid #c7d5e6;border-radius:50%;color:var(--blue,#004aad);font-weight:800;font-size:10px;font-variant-numeric:tabular-nums}.ds-path-title{font-size:14px;font-weight:800;display:block}.ds-path-description{display:block;color:var(--muted,#53657b);font-size:12px;line-height:1.7;margin-top:4px}.ds-path-time{color:var(--muted,#53657b);font-size:9px;white-space:nowrap}.ds-path-row.ds-complete .ds-path-index{background:#e6f5ed;border-color:#afd4c0;color:var(--green,#126341)}.ds-path-row.ds-complete .ds-path-time{color:var(--green,#126341)}.ds-path-row:focus-visible{outline:3px solid var(--sky,#38b6ff);outline-offset:4px}@media(max-width:760px){.ds-path-row{grid-template-columns:31px 1fr 16px;gap:13px;padding:19px 0}.ds-path-index{width:30px;height:30px}.ds-path-time{display:none}}"
