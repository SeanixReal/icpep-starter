      "description": "Labeled search field inside the toolkit search dialog.",
      "html": "<label class=\"ds-search-label\" for=\"ds-guide-search\">Search guides, commands, and common problems</label><div class=\"ds-search-field\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m21 21-5-5m2-6a8 8 0 1 1-16 0 8 8 0 0 1 16 0\"></path></svg><input id=\"ds-guide-search\" type=\"search\" placeholder=\"Try “Python” or “PATH”…\" autocomplete=\"off\"></div>",
      "css": ".ds-search-label{display:block;font-family:var(--body,Manrope,sans-serif);font-size:11px;color:var(--muted,#53657b);margin:18px 0 9px}.ds-search-field{display:flex;gap:10px;align-items:center;border:1px solid #a3b6ce;border-radius:6px;padding:0 13px;color:var(--ink,#152b48)}.ds-search-field input{min-width:0;width:100%;border:0;padding:12px 0;outline:0;background:transparent;color:var(--ink,#152b48);font-family:var(--body,Manrope,sans-serif);font-size:14px;caret-color:var(--blue,#004aad)}.ds-search-field:focus-within{outline:3px solid #38b6ff60;border-color:var(--blue,#004aad)}.ds-search-field input::placeholder{color:var(--muted,#53657b)}"
    },
    {
      "name": "Chapter Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Rail links with a white active-page state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Toolkit navigation\"><a class=\"ds-nav-link ds-active\" href=\"#overview\" aria-current=\"page\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v16M12 5C9 2 5 2 2 4v16c4-2 7-1 10 1 3-2 6-3 10-1V4c-3-2-7-2-10 1\"></path></svg>Overview</a><a class=\"ds-nav-link\" href=\"#readiness\"><span class=\"ds-nav-number\">01</span>Before you begin</a><a class=\"ds-nav-link\" href=\"#vscode\"><span class=\"ds-nav-number\">02</span>Install VS Code</a></nav>",
      "css": ".ds-nav{background:var(--rail,#073679);padding:14px;width:224px;font-family:var(--body,Manrope,sans-serif)}.ds-nav-link{display:flex;align-items:center;gap:11px;min-height:40px;padding:9px 12px;color:#d4e2f7;text-decoration:none;font-size:13px;border-radius:6px;line-height:1.5}.ds-nav-link:hover{background:#124586;color:var(--paper,#ffffff)}.ds-nav-link.ds-active{background:var(--paper,#ffffff);color:var(--rail,#073679);font-weight:800}.ds-nav-number{font-size:10px;font-weight:700;min-width:17px;font-variant-numeric:tabular-nums}.ds-nav-link:focus-visible{outline:3px solid var(--sky,#38b6ff);outline-offset:4px}"
