{
  "name": "icpep-starter-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "A community-maintained programming setup toolkit for beginner CpE students at CIT-U.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-downloads.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "prestart": "node scripts/prepare-downloads.mjs",
    "start": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "pretest": "node scripts/prepare-downloads.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:samples": "node scripts/check-samples.mjs",
    "build": "node scripts/prepare-downloads.mjs && astro build && node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/unbounded": "^5.2.8",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "yaml": "^2.8.3"
  }
}
